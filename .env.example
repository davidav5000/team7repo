PORT=3000
NODE_ENV=development
# Required in production. Use a long, random value and never commit the real secret.
SESSION_SECRET=change-me
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/activities

BCRYPT_ROUNDS=12
# Enable Maps Static API and Places API (New) for this server-side key.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
