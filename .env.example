PORT=3000
NODE_ENV=development
# Required in production. Use a long, random value and never commit the real secret.
SESSION_SECRET=change-me
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/activities
# Optional core integration tests only: use a separate database ending in _test.
# Export this in your shell before npm test; Jest does not load this file.
CORE_TEST_DATABASE_URL=

BCRYPT_ROUNDS=12
# Enable Maps Static API and Places API (New) for this server-side key.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
